  EarthQuakeForcast:
  - "\u8FD1\u65E5\u591A\u5730\u6751\u6C11\u4E0A\u62A5\uFF0C\u5BB6\u4E2D\u9E21\u72AC\u4E0D\u5B81\uFF0C\u725B\u7F8A\u8E81\u52A8\u4E0D\u5B89\uFF0C\u751A\u81F3\u98DE\u9E1F\u60CA\u6563"
  - "\u6E14\u6237\u53D1\u73B0\uFF0C\u6CB3\u4E2D\u9C7C\u7FA4\u7FFB\u817E\u4E0D\u6B62\uFF0C\u9891\u9891\u8DC3\u51FA\u6C34\u9762\uFF0C\u751A\u6709\u9C7C\u7FA4\u805A\u96C6\u6D45\u6EE9"
  - "\u4E61\u6C11\u4E0A\u62A5\uFF0C\u6751\u4E2D\u4E95\u6C34\u5FFD\u6DA8\u5FFD\u843D\uFF0C\u6C34\u8D28\u6D51\u6D4A\uFF0C\u4E14\u6709\u5F02\u5473"
  - "\u591C\u5DE1\u66F4\u592B\u62A5\uFF0C\u5929\u73B0\u5F02\u5149\uFF0C\u5730\u5E95\u4F20\u6765\u9686\u9686\u4E4B\u58F0\uFF0C\u4F3C\u6709\u5730\u9F99\u7FFB\u8EAB\u4E4B\u5146"
  - "\u7530\u95F4\u519C\u592B\u53D1\u73B0\uFF0C\u5730\u73B0\u7EC6\u7F1D\uFF0C\u571F\u77F3\u5FAE\u52A8\uFF0C\u4F3C\u6709\u5F02\u53D8"
  FloodForcast:
  - "\u8FDE\u65E5\u66B4\u96E8\uFF0C\u6CB3\u6C34\u66B4\u6DA8\uFF0C\u4F4E\u6D3C\u4E4B\u5730\u5DF2\u6210\u6CFD\u56FD"
  - "\u4E61\u6C11\u4E0A\u62A5\uFF0C\u7530\u5730\u79EF\u6C34\u4E0D\u9000\uFF0C\u6CE5\u571F\u677E\u8F6F\uFF0C\u5C71\u4F53\u5FAE\u52A8"
