  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e373e41199793b84a8eab5e225b6ff46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  earthQuake: {fileID: 11400000, guid: 2a57f8fc61c4b0b4683e3503cfd103fb, type: 2}
  flood: {fileID: 11400000, guid: 3e2340b8dbd204f4bb019f590661f482, type: 2}
  dustStorm: {fileID: 11400000, guid: 3783e58941755744781fdd3218c95a29, type: 2}
  fog: {fileID: 11400000, guid: 62f587cac1aceb14b8b21ed215878616, type: 2}
  disasterEffect: {fileID: 5980617478727847611, guid: 0147845d65a606a4ea3ffa9e573d02ec, type: 3}
  images: []
  canvas: {fileID: 1202395601}
  tmpText: {fileID: 5969882976790733649}
  EarthQuakeForcast:
  - "\u8FD1\u65E5\u591A\u5730\u6751\u6C11\u4E0A\u62A5\uFF0C\u5BB6\u4E2D\u9E21\u72AC\u4E0D\u5B81\uFF0C\u725B\u7F8A\u8E81\u52A8\u4E0D\u5B89\uFF0C\u751A\u81F3\u98DE\u9E1F\u60CA\u6563"
  - "\u6E14\u6237\u53D1\u73B0\uFF0C\u6CB3\u4E2D\u9C7C\u7FA4\u7FFB\u817E\u4E0D\u6B62\uFF0C\u9891\u9891\u8DC3\u51FA\u6C34\u9762\uFF0C\u751A\u6709\u9C7C\u7FA4\u805A\u96C6\u6D45\u6EE9"
  - "\u4E61\u6C11\u4E0A\u62A5\uFF0C\u6751\u4E2D\u4E95\u6C34\u5FFD\u6DA8\u5FFD\u843D\uFF0C\u6C34\u8D28\u6D51\u6D4A\uFF0C\u4E14\u6709\u5F02\u5473"
  - "\u591C\u5DE1\u66F4\u592B\u62A5\uFF0C\u5929\u73B0\u5F02\u5149\uFF0C\u5730\u5E95\u4F20\u6765\u9686\u9686\u4E4B\u58F0\uFF0C\u4F3C\u6709\u5730\u9F99\u7FFB\u8EAB\u4E4B\u5146"
  - "\u7530\u95F4\u519C\u592B\u53D1\u73B0\uFF0C\u5730\u73B0\u7EC6\u7F1D\uFF0C\u571F\u77F3\u5FAE\u52A8\uFF0C\u4F3C\u6709\u5F02\u53D8"
  FloodForcast:
  - "\u8FDE\u65E5\u66B4\u96E8\uFF0C\u6CB3\u6C34\u66B4\u6DA8\uFF0C\u4F4E\u6D3C\u4E4B\u5730\u5DF2\u6210\u6CFD\u56FD"
  - "\u4E61\u6C11\u4E0A\u62A5\uFF0C\u7530\u5730\u79EF\u6C34\u4E0D\u9000\uFF0C\u6CE5\u571F\u677E\u8F6F\uFF0C\u5C71\u4F53\u5FAE\u52A8"
  - "\u6CB3\u5DE5\u53D1\u73B0\uFF0C\u6C34\u6D41\u6E4D\u6025\uFF0C\u6CE5\u6C99\u4FF1\u4E0B\uFF0C\u6CB3\u5CB8\u6709\u5D29\u584C\u4E4B\u8C61"
  - "\u5C71\u4E2D\u730E\u6237\u62A5\uFF0C\u5C71\u5761\u6CE5\u571F\u677E\u52A8\uFF0C\u77F3\u5757\u6EDA\u843D\uFF0C\u6050\u6709\u5C71\u5D29\u4E4B\u9669"
  DustStormForcast:
  - "\u8FD1\u65E5\u72C2\u98CE\u9AA4\u8D77\uFF0C\u9EC4\u6C99\u6F2B\u5929\uFF0C\u65E5\u8272\u660F\u6697"
  - "\u5546\u65C5\u4E0A\u62A5\uFF0C\u8FDC\u5904\u666F\u7269\u96BE\u8FA8\uFF0C\u98CE\u6C99\u853D\u65E5\uFF0C\u884C\u8DEF\u8270\u96BE"
  - "\u4E61\u6C11\u53D1\u73B0\uFF0C\u98CE\u6C99\u8FC7\u540E\uFF0C\u5C4B\u820D\u7686\u8986\u9EC4\u5C18\uFF0C\u547C\u5438\u4E0D\u7545"
  - "\u519C\u4EBA\u4E0A\u62A5\uFF0C\u7530\u95F4\u4F5C\u7269\u7686\u88AB\u6C99\u5C18\u8986\u76D6\uFF0C\u679D\u53F6\u6298\u65AD"
  FogForcast:
  - "\u8FD1\u65E5\u6668\u8D77\u96FE\u6C14\u5F25\u6F2B\uFF0C\u5341\u6B65\u4E4B\u5916\u96BE\u8FA8\u4EBA\u5F71"
  - "\u4E61\u6C11\u53D1\u73B0\uFF0C\u591C\u95F4\u5BD2\u6C14\u903C\u4EBA\uFF0C\u6668\u8D77\u9732\u6C34\u51DD\u7ED3\uFF0C\u96FE\u6C14\u539A\u91CD"
  - "\u5B98\u5E9C\u89C2\u5BDF\uFF0C\u8FD1\u65E5\u65E0\u98CE\uFF0C\u96FE\u6C14\u96BE\u6563\uFF0C\u80FD\u89C1\u5EA6\u6781\u4F4E"
  - "\u519C\u4EBA\u4E0A\u62A5\uFF0C\u7530\u95F4\u4F5C\u7269\u7686\u8986\u9732\u6C34\uFF0C\u96FE\u6C14\u5F25\u6F2B"
  - "\u5546\u65C5\u53CD\u6620\uFF0C\u96FE\u6C14\u65F6\u6D53\u65F6\u6DE1\uFF0C\u884C\u8DEF\u8270\u96BE"
