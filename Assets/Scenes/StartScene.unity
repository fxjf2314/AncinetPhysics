    - target: {fileID: 2375098851387540800, guid: 3cf5e4c02c9efb844a7efbeb37f1b3bc, type: 3}
      propertyPath: videoDic.keys.Array.data[6]
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 2375098851387540800, guid: 3cf5e4c02c9efb844a7efbeb37f1b3bc, type: 3}
      propertyPath: videoDic.keys.Array.data[7]
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 2375098851387540800, guid: 3cf5e4c02c9efb844a7efbeb37f1b3bc, type: 3}
      propertyPath: textDic.values.Array.data[0]
      value: "\u70B9\u51FB\u5F00\u59CB\u6309\u94AE\u540E\u8FDB\u5165\u5361\u724C\u9009\u62E9\u754C\u9762\uFF0C\u5DE6\u952E\u5355\u51FB\u5361\u724C\u53EF\u4EE5\u5C06\u5176\u52A0\u5165\u624B\u724C\u5E93\uFF0C\u5BF9\u624B\u724C\u5E93\u4E2D\u5361\u724C\u53F3\u952E\u5355\u51FB\u53EF\u4EE5\u5C06\u5176\u79FB\u9664\u624B\u724C\u5E93\uFF0C\u4E5F\u53EF\u4EE5\u70B9\u51FB\u53F3\u4FA7\u6309\u94AE\u6E05\u7A7A\u624B\u724C\u5E93\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 2375098851387540800, guid: 3cf5e4c02c9efb844a7efbeb37f1b3bc, type: 3}
      propertyPath: textDic.values.Array.data[1]
      value: "\u5C06\u9F20\u6807\u79FB\u81F3\u5361\u724C\u4E0A\u65F6\u4F1A\u663E\u793A\u5361\u724C\u7684\u4F5C\u7528\u8303\u56F4\u548C\u4F5C\u7528\u6548\u679C\uFF0C\u7B49\u5F85\u9F20\u6807\u65C1\u8FDB\u5EA6\u6761\u8F7D\u6EE1\u540E\u5DE6\u952E\u5355\u51FB\u5373\u53EF\u67E5\u770B\u5361\u724C\u7684\u8BE6\u7EC6\u5386\u53F2\u4ECB\u7ECD\u3002\u914D\u7F6E\u597D\u624B\u724C\u540E\u5373\u53EF\u6B63\u5F0F\u8FDB\u5165\u6E38\u620F\uFF08\u65E0\u9700\u914D\u6EE18\u5F20\uFF09\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 2375098851387540800, guid: 3cf5e4c02c9efb844a7efbeb37f1b3bc, type: 3}
      propertyPath: textDic.values.Array.data[2]
      value: "\u5730\u56FE\u603B\u5171\u5206\u4E3A\u5317\u90E8\u3001\u897F\u90E8\u3001\u4E2D\u90E8\u3001\u897F\u5357\u3001\u5357\u90E8\u51715\u4E2A\u533A\u57DF\uFF0C\u9F20\u6807\u79FB\u81F3\u5BF9\u5E94\u533A\u57DF\u65F6\u8BE5\u4F1A\u5C06\u8BE5\u533A\u57DF\u63CF\u8FB9\u5E76\u663E\u793A\u540D\u79F0\u548C\u4EBA\u53E3\u3002\u5355\u51FB\u533A\u57DF\u53EF\u5C06\u955C\u5934\u79FB\u81F3\u8BE5\u533A\u57DF\u4E0A\u65B9\u540C\u65F6\u5728\u5DE6\u4E0B\u89D2\u663E\u793A\u8BE5\u533A\u57DF\u7684\u8BE6\u7EC6\u4FE1\u606F\uFF0C\u6ED1\u52A8\u6EDA\u8F6E\u53EF\u4EE5\u653E\u5927\u6216\u7F29\u5C0F\u89C6\u89D2\uFF0C\u6309\u4F4F\u6EDA\u8F6E\u53EF\u4EE5\u79FB\u52A8\u89C6\u89D2\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 2375098851387540800, guid: 3cf5e4c02c9efb844a7efbeb37f1b3bc, type: 3}
      propertyPath: textDic.values.Array.data[3]
      value: "\u6B63\u4E0B\u65B9\u4E09\u5F20\u5361\u724C\u662F\u53EF\u4EE5\u90E8\u7F72\u5230\u533A\u57DF\u7684\u624B\u724C\uFF0C\u5C06\u9F20\u6807\u79FB\u81F3\u8981\u90E8\u7F72\u7684\u5361\u724C\u4E0A\u957F\u6309\u53F3\u952E\u62D6\u62FD\u5230\u67D0\u4E00\u533A\u57DF\u4E0A\u677E\u5F00\u53F3\u952E\u7136\u540E\u5DE6\u952E\u5355\u51FB\u786E\u8BA4\u5373\u53EF\u90E8\u7F72\u6210\u529F\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 2375098851387540800, guid: 3cf5e4c02c9efb844a7efbeb37f1b3bc, type: 3}
      propertyPath: textDic.values.Array.data[4]
      value: "\u90E8\u5206\u5361\u724C\u4F5C\u7528\u6548\u679C\u6709\u591A\u4E2A\u533A\u57DF\uFF0C\u5728\u70B9\u51FB\u786E\u8BA4\u6309\u94AE\u4E4B\u524D\u6309w\u952E\u53EF\u4EE5\u6539\u53D8\u4F5C\u7528\u65B9\u5411\uFF0C\u5361\u724C\u7684\u4F5C\u7528\u533A\u57DF\u4F1A\u9AD8\u4EAE\u663E\u793A\u3002\u6BCF\u4E2A\u5730\u533A\u6700\u591A\u653E\u7F6E\u4E09\u5F20\u5361\u724C\uFF0C\u6BCF\u4E2A\u56DE\u5408\u6700\u591A\u653E\u7F6E\u4E00\u5F20\u5361\u724C\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 2375098851387540800, guid: 3cf5e4c02c9efb844a7efbeb37f1b3bc, type: 3}
      propertyPath: textDic.values.Array.data[5]
      value: "\u5C4F\u5E55\u53F3\u8FB9\u7684\u611F\u53F9\u53F7\u4EE3\u8868\u7740\u968F\u673A\u4E8B\u4EF6\uFF0C\u70B9\u51FB\u53EF\u4EE5\u67E5\u770B\u8BE6\u60C5\u3002\u5C4F\u5E55\u5DE6\u4E0A\u89D2\u6709\u56DE\u5408\u6570\u3001\u4EBA\u53E3\u3001\u4EA7\u51FA\u3001\u6536\u6210\uFF0C\u5C06\u9F20\u6807\u79FB\u81F3\u5BF9\u5E94\u56FE\u6807\u5373\u53EF\u67E5\u770B\u8BE6\u60C5\u3002\u70B9\u51FB\u53F3\u4E0B\u89D2\u5373\u53EF\u8FDB\u5165\u4E0B\u4E00\u56DE\u5408\uFF0C\u8FDB\u5165\u65B0\u56DE\u5408\u6BCF\u4E2A\u5730\u533A\u4F1A\u663E\u793A\u4EBA\u53E3\u3001\u4EA7\u51FA\u3001\u6536\u6210\u7684\u589E\u957F\u91CF\uFF0C\u6700\u7EC8\u76EE\u6807\u662F\u4F7F\u6536\u6210\u548C\u4EA7\u51FA\u6700\u5927\u5316\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 2375098851387540800, guid: 3cf5e4c02c9efb844a7efbeb37f1b3bc, type: 3}
      propertyPath: textDic.values.Array.data[6]
      value: "\u5DE6\u952E\u5355\u51FB\u53F3\u4E0A\u89D2\u53EF\u4EE5\u8FDB\u5165\u8BBE\u7F6E\u754C\u9762\uFF0C\u53EF\u4EE5\u8C03\u6574\u80CC\u666F\u97F3\u4E50\u97F3\u91CF\uFF0C\u5B58\u6863\u3001\u8BFB\u6863\u3001\u8FD4\u56DE\u6807\u9898\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 2375098851387540800, guid: 3cf5e4c02c9efb844a7efbeb37f1b3bc, type: 3}
      propertyPath: textDic.values.Array.data[7]
      value: "\u6BCF\u4E2A\u56DE\u5408\u53EF\u80FD\u4F1A\u6709\u968F\u673A\u707E\u5BB3\uFF0C\u6BCF\u4E2A\u707E\u5BB3\u90FD\u6709\u4E0D\u540C\u6548\u679C\uFF0C\u53EF\u4EE5\u9009\u62E9\u76F8\u5E94\u7684\u5361\u724C\u6765\u5E94\u5BF9\u707E\u5BB3\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 2375098851387540800, guid: 3cf5e4c02c9efb844a7efbeb37f1b3bc, type: 3}
